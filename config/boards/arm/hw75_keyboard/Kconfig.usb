config HW75_USB_COMM
	default y
	select HW75_USB_COMM_FEATURE_RGB
	select HW75_USB_COMM_FEATURE_KEYMAP if HW75_KEYMAP_REMAP

if HW75_USB_COMM

config HW75_USB_COMM_MAX_TX_MESSAGE_SIZE
	int
	default 64

config HW75_USB_COMM_MAX_RX_MESSAGE_SIZE
	int
	default 64

config HW75_USB_COMM_RX_QUEUE_SIZE
	int
	default 2 if HW75_KEYMAP_REMAP

config HW75_USB_COMM_MAX_BYTES_FIELD_SIZE
	int
	default 54 if HW75_KEYMAP_REMAP

config HW75_USB_COMM_THREAD_STACK_SIZE
	int
	default 768 if HW75_KEYMAP_REMAP

endif # HW75_USB_COMM
